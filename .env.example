# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB Atlas connection string, e.g.:
# mongodb+srv://<user>:<password>@<cluster-host>/wa_lead_tracker?retryWrites=true&w=majority
MONGODB_URI=

# Random secret the extension must send as "Authorization: Bearer <this value>".
# Generate one with: openssl rand -hex 32
API_KEY=

# Random secret used to sign login tokens for the web dashboard's users.
# Generate one with: openssl rand -hex 32 (use a DIFFERENT value than API_KEY)
JWT_SECRET=

# Optional, defaults to 3000
PORT=3000
